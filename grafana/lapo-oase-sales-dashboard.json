          "rawSql": "select\n  created_at_wib_text as waktu_wib,\n  order_number,\n  coalesce(customer_name, '-') as customer_name,\n  status,\n  coalesce(category, '-') as category,\n  name as item,\n  quantity,\n  unit_price,\n  gross_line_total,\n  discount_amount,\n  net_line_total,\n  coalesce(notes, '-') as item_notes\nfrom public.pos_order_items_analytics\nwhere $__timeFilter(created_at)\norder by created_at desc, sort_order asc\nlimit 200;",
