          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select\n  created_at_wib_text as waktu_wib,\n  order_number,\n  coalesce(customer_name, '-') as customer_name,\n  status,\n  string_agg(\n    quantity || 'x ' || name || ' @ Rp' || trim(to_char(unit_price, 'FM999G999G999G999')),\n    E'\\n'\n    order by sort_order, name\n  ) as items,\n  max(order_total) + coalesce(sum(discount_amount), 0) as subtotal,\n  coalesce(sum(discount_amount), 0) as discount,\n  max(order_total) as total\nfrom public.pos_order_items_analytics\nwhere $__timeFilter(created_at)\ngroup by created_at_wib_text, order_number, customer_name, status, created_at\norder by created_at desc\nlimit 50;",
          "refId": "A"
        }
      ],
